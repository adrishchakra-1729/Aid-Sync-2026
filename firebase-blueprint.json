{
  "entities": {
    "Need": {
      "title": "Community Need",
      "description": "A crisis or community need reported by a user.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Short title of the need" },
        "description": { "type": "string", "description": "Detailed description of the crisis" },
        "location": { "type": "string", "description": "Geographic location" },
        "urgency": { "type": "string", "enum": ["low", "medium", "high"], "description": "Severity level" },
        "status": { "type": "string", "enum": ["open", "matched", "resolved"], "description": "Status of the report" },
        "reporterId": { "type": "string", "description": "UID of the reporter" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "location", "urgency", "status", "reporterId", "createdAt"]
    },
    "Volunteer": {
      "title": "Volunteer Profile",
      "description": "Skills and info for a volunteer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user" },
        "displayName": { "type": "string", "description": "Name of the volunteer" },
        "email": { "type": "string", "description": "Email of the volunteer" },
        "bio": { "type": "string", "description": "Short biography" },
        "skills": { "type": "array", "items": { "type": "string" }, "description": "List of skills" },
        "availability": { "type": "string", "description": "Availability status" },
        "photoURL": { "type": "string", "description": "Profile picture URL" }
      },
      "required": ["userId", "displayName", "email", "skills"]
    },
    "Match": {
      "title": "AI Match",
      "description": "A match between a need and a volunteer generated by AI.",
      "type": "object",
      "properties": {
        "needId": { "type": "string", "description": "ID of the need" },
        "volunteerId": { "type": "string", "description": "ID of the volunteer" },
        "reasoning": { "type": "string", "description": "AI-generated reasoning for the match" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"], "description": "Status of the match" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["needId", "volunteerId", "reasoning", "status", "createdAt"]
    }
  },
  "firestore": {
    "needs": {
      "schema": "Need",
      "description": "Collection of community needs."
    },
    "volunteers": {
      "schema": "Volunteer",
      "description": "Collection of volunteer profiles."
    },
    "matches": {
      "schema": "Match",
      "description": "Collection of AI matches."
    }
  }
}
