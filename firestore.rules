rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Needs Collection
    match /needs/{needId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.keys().hasAll(['title', 'description', 'location', 'urgency', 'status', 'reporterId', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // Volunteers Collection
    match /volunteers/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.skills is list
        && request.resource.data.skills.size() <= 20;
    }

    // Matches Collection
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}
